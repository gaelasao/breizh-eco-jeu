# Variables d'environnement réellement lues par Living Business (src/passerelle/serveur.ts, lanceur.ts, http.ts,
# stockage.ts, sortant.ts). Toutes sont facultatives. Le jeu ne lit pas de fichier .env tout seul : passez-les au
# lancement (node --env-file=.env src/passerelle/serveur.ts) ou dans l'unité systemd. Ne commitez jamais un .env.
#
# La clé d'organisation Breizhcosystem n'est PAS une variable : elle s'obtient par la liaison (Réglages › Breizhcosystem) et reste
# chiffrée dans les données du jeu. Ne la recopiez nulle part.

# --- Serveur
# Port d'écoute (4173 par défaut) et adresse (127.0.0.1 par défaut : jamais 0.0.0.0 sans proxy devant).
PORT=4173
HOST=127.0.0.1
# Dossier des données (monde.json, sauvegardes). « memoire » : rien n'est enregistré (démonstration).
LB_DONNEES=

# --- Réseau Breizhcosystem (facultatif)
# Adresse de Breizhcosystem proposée par défaut (https seulement). L'administrateur peut la régler dans Réglages › Breizhcosystem.
LB_NEXUS_URL=

# --- Mise en ligne (serveur de l'entreprise, derrière Caddy : réglé par deploiement/installer-jeu.sh)
# 1 = mode site internet : comptes, code d'installation, validation en deux étapes obligatoire pour les administrateurs.
LB_EN_LIGNE=
# 1 = derrière un proxy HTTPS sur la même machine (Caddy) : l'adresse du visiteur est lue dans X-Forwarded-For.
LB_PROXY=
# Adresse publique, ex. https://jeu.mondomaine.fr (contrôle Origin, liens d'installation et de formulaires).
LB_ORIGINE=
# Autres noms d'hôte acceptés, séparés par des virgules (en plus de celui de LB_ORIGINE).
LB_HOTES=
# 1 = cookie de session « Secure » (toujours en https).
LB_COOKIE_SECURE=
# 1 = la clé des secrets n'est jamais lue ni créée dans le dossier des données : elle vient de l'identifiant systemd
# « cle-secrets » (LoadCredential, réglé par l'installateur) ou de LB_CLE_SECRETS ; sinon le démarrage est refusé.
LB_CLE_HORS_DONNEES=
# 32 octets en base64. À éviter : préférez l'identifiant systemd « cle-secrets ». Jamais dans un fichier commité.
LB_CLE_SECRETS=

# --- Poste de travail (paquet de bureau)
# 0 = ne pas ouvrir le navigateur au lancement.
LB_NAVIGATEUR=

# --- Démonstration et développement
# « demo » : choix d'un profil sans mot de passe (npm run demo). Jamais en ligne.
LB_CONNEXION=
# Exemple fictif chargé en démonstration : eti ou pme.
EXEMPLE=
# 1 = autorise http://localhost et 127.0.0.1 pour les appels sortants (tests, n8n local). Jamais en production.
LB_AUTORISER_LOCAL=

# --- Pont MCP pour Claude Desktop (src/mcp/pont-stdio.ts)
# Adresse du jeu et clé d'API (créée dans Réglages › Connecteurs › Clés d'API) : à mettre dans la configuration de
# Claude Desktop, pas ici.
# LB_URL=http://127.0.0.1:4173
# LB_CLE=

# --- Fabrication des paquets (scripts/paquets.ts)
# Version exacte de Node.js à embarquer (vXX.YY.ZZ), ou majeure à suivre (24 par défaut).
LB_NODE_VERSION=
LB_NODE_MAJEUR=
